# Required for Live AI (the normal mode). Get a key at https://console.anthropic.com/
# Without it, TaxHub falls back to an offline demo: scripted replies for the sample
# GmbH case only, with citations still produced by real knowledge-base retrieval.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. low | medium | high. Overrides the defaults (chat turns: low, adviser handover: medium).
# TAXHUB_EFFORT=low

# Optional. Set to "true" to turn off the server-side refusal fallback (beta).
# If the API rejects the beta, TaxHub already retries without it automatically.
# TAXHUB_DISABLE_FALLBACKS=false
