# Required for live AI mode. Get one at https://console.anthropic.com/
# Without it, TaxHub runs in "offline demo mode": real knowledge-base retrieval,
# scripted responses for the seeded GmbH scenario only.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. low | medium | high. Defaults to medium (good balance of latency and extraction quality).
# TAXHUB_EFFORT=medium

# Optional. Set to "true" to turn off the server-side refusal fallback (beta).
# TAXHUB_DISABLE_FALLBACKS=false
